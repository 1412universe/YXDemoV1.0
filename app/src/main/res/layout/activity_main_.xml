<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#455D79"
    android:screenOrientation="landscape"
    tools:context=".Main_Activity">

    <LinearLayout
        android:id="@+id/ll_layout"
        android:layout_width="431dp"
        android:layout_height="263dp"
        android:layout_marginStart="242dp"
        android:background="#00000000"
        android:clipChildren="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/rw"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="233dp"
            android:layout_height="212dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:clipChildren="false" />

    </LinearLayout>

    <Button
        android:id="@+id/UsrBtn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/usrbtn"
        android:onClick="onClickNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

    <Button
        android:id="@+id/FriendBtn"
        android:layout_width="27dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="315dp"
        android:background="@drawable/friend"
        android:onClick="onClickNext"
        app:layout_constraintBottom_toBottomOf="@+id/rw"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/UsrBtn"
        app:layout_constraintVertical_bias="0.823"
        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

    <ImageView
        android:id="@+id/rw"
        android:layout_width="238dp"
        android:layout_height="402dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="27dp"
        app:layout_constraintStart_toStartOf="@+id/UsrBtn"
        app:layout_constraintTop_toTopOf="@+id/UsrBtn"
        app:srcCompat="@drawable/rw" />

</androidx.constraintlayout.widget.ConstraintLayout>
